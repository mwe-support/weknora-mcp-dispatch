WEKNORA_BASE_URL=http://app:8080/api/v1
WEKNORA_VERIFY_SSL=true

MCP_AUTH_MODE=weknora_api_key
MCP_READ_ONLY=true
MCP_HTTP_PATH=/mcp
MCP_API_KEY_VALIDATION_TTL_SECONDS=60
MCP_API_KEY_VALIDATION_CACHE_MAX_ENTRIES=2048
MCP_API_KEY_VALIDATION_MAX_CONCURRENCY=16

# Keep both empty in request-scoped mode.
WEKNORA_API_KEY=
MCP_SERVER_AUTH_TOKEN=
